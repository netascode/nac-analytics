# Terraform / ACI provider credentials for Nexus Dashboard examples/nexus_dashboard/terraform/.
#
# Copy to env.sh (gitignored), edit, then: source env.sh
#
# APIC credentials may differ from Nexus Dashboard login — same host is common
# on integrated deployments, but usernames and domains often are not.

export TF_VAR_aci_url="https://your-apic-or-nd-host"
export TF_VAR_aci_username="admin"
export TF_VAR_aci_password="change-me"
